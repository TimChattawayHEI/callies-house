{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{6}$/)"
      }
    },
    "post": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-HJ-NP-Z]{6}$/)"
      }
    }
  }
}
