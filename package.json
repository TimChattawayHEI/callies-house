{
  "name": "callies-house",
  "version": "1.0.0",
  "private": true,
  "description": "Callie's House: an isometric reading game, packaged as an Android app with Capacitor.",
  "scripts": {
    "build": "python3 scripts/build_app.py",
    "android:add": "npx cap add android",
    "android:icons": "npx capacitor-assets generate --android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@fontsource/andika": "^5.0.0",
    "esbuild": "0.28.2"
  }
}
